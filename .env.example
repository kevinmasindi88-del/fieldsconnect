# FieldsConnect Environment Variables
# Copy this file to .env.local for local development.
# Never commit real secrets.

# App
NEXT_PUBLIC_APP_NAME="FieldsConnect"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Auth / Security
NEXT_PUBLIC_REQUIRE_AGE_CONFIRMATION="true"
NEXT_PUBLIC_MINIMUM_AGE="18"

# Operations
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Paid mentorship must remain disabled until FC business bank verification,
# Paystack production KYC, approved finance terms/policies, refund controls,
# and controlled live payment QA are completed.
# Leaving this false hides public payout and pricing controls, while preserving test data.
NEXT_PUBLIC_FC_PAID_MENTORSHIPS_ENABLED="false"
# The two Supabase Edge Functions also require a separate server-side
# FC_PAID_MENTORSHIPS_ENABLED=true secret to activate; leave unset until launch.
